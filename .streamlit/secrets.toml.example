# Copy to .streamlit/secrets.toml and fill in. Never commit the real file.

# Optional: enables the "AI second opinion" feature on the Classify page.
# The app works fully without it - the trained model is the primary classifier.
# Configure ONE of these. Groq is used first when both are present.
GROQ_API_KEY = "gsk_..."
# ANTHROPIC_API_KEY = "sk-ant-..."

# Bootstrap administrator account, created on first run.
ADMIN_USERNAME = "admin"
ADMIN_PASSWORD = "change-this-to-something-strong"

# Set to "false" to hide the self-service registration tab on the sign-in page.
ALLOW_SELF_SIGNUP = "true"
