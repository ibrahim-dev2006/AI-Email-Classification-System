# Local development alternative to .streamlit/secrets.toml.
# Export these in your shell, or use them on hosts that inject environment variables.

# Configure ONE AI provider. Groq is used first when both are present.
GROQ_API_KEY=gsk_...
# ANTHROPIC_API_KEY=sk-ant-...

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-something-strong
ALLOW_SELF_SIGNUP=true
